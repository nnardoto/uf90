program modules
  use kinematics, only: advance
  implicit none

  real :: x, v, a, Δt

  x = 0.0
  v = 10.0
  a = -9.8
  Δt = 0.5

  call advance(x, v, a, Δt)

  if (abs(x - 3.775) > 1.0e-5) error stop "posição incorreta"
  if (abs(v - 5.1) > 1.0e-5) error stop "velocidade incorreta"
  print *, "após Δt =", Δt, ": x =", x, "v =", v
end program modules
